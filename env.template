# Copy this file to .env only for local development.
# Never commit .env. Never use .env in cloud routines.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Hard guard: this project is paper-only.
TRADING_MODE=paper
ALPACA_PAPER=true
LIVE_TRADING_CONFIRMED=false
ALLOW_PAPER_ORDER_SUBMISSION=false

# Alpaca stock data feed. IEX is usually available to paper/free accounts; SIP requires the correct plan.
ALPACA_DATA_FEED=iex

# Optional local-only tuning.
LOG_LEVEL=INFO

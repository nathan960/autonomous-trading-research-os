# Secrets
.env
.env.*
!.env.template

# Nested repo accidentally cloned inside the project root
autonomous-trading-research-os/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# OS/editor
.DS_Store
.vscode/
.idea/

# Runtime scratch logs. Audit logs live in memory/*.md and data/latest/*.json.
logs/*
!logs/.gitkeep

# Archives can grow large; commit selected archives intentionally if needed.
data/archive/*
!data/archive/.gitkeep

# History snapshots grow with every run; commit selectively.
data/history/snapshots/*
!data/history/snapshots/.gitkeep

# Trigger history JSONL files grow with every run; commit selectively.
data/history/triggers/*
!data/history/triggers/.gitkeep

# Execution history grows with every run; commit selectively.
data/history/executions/*
!data/history/executions/.gitkeep

# Per-order audit logs grow with every run; commit selectively.
data/history/orders/*
!data/history/orders/.gitkeep

# Build artifacts
dist/
build/
*.egg-info/

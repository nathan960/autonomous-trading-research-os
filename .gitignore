# Secrets
.env
.env.*
!.env.template

# Nested repo accidentally cloned inside the project root
autonomous-trading-research-os/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# OS/editor
.DS_Store
.vscode/
.idea/

# Runtime scratch logs. Audit logs live in memory/*.md and data/latest/*.json.
logs/*
!logs/.gitkeep

# Archives can grow large; commit selected archives intentionally if needed.
data/archive/*
!data/archive/.gitkeep

# History snapshots grow with every run; commit selectively.
data/history/snapshots/*
!data/history/snapshots/.gitkeep

# Trigger history JSONL files grow with every run; commit selectively.
data/history/triggers/*
!data/history/triggers/.gitkeep

# Paper execution reports (*_paper.json) are auditable records — always committed.
# Dry-run execution reports are ephemeral (captured in data/latest/).
data/history/executions/*_dry_run.json

# Per-order audit logs (TOS-*.json) are auditable records — always committed.
# Per-run monitor report files are ephemeral (captured in data/latest/ and TRADE-LOG.md).
data/history/orders/order_monitor_*.json

# Build artifacts
dist/
build/
*.egg-info/
